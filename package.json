{
  "name": "@frotopay/walkthroughs",
  "version": "0.1.0",
  "description": "Browser journeys that test an app and record it as a step-by-step walkthrough: the recorder, the player, offline files and review cards.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "exports": {
    "./record": { "types": "./dist/record/index.d.ts", "default": "./dist/record/index.js" },
    "./manifest": { "types": "./dist/manifest/index.d.ts", "default": "./dist/manifest/index.js" },
    "./player": { "types": "./dist/player/index.d.ts", "default": "./dist/player/index.js" },
    "./theme.css": "./src/player/theme.css"
  },
  "bin": { "walkthroughs": "bin/walkthroughs.mjs" },
  "files": ["dist", "bin", "tools", "src/player/theme.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config vite.offline.config.ts --logLevel warn",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "playwright test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50",
    "lucide-react": ">=0.400",
    "react": "^18.3.0 || ^19.0.0",
    "sharp": ">=0.33"
  },
  "peerDependenciesMeta": {
    "lucide-react": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.33.5",
    "tailwindcss": "4.2.2",
    "typescript": "5.6.3",
    "vite": "6.0.3"
  }
}
